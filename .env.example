PORT=5000
JWT_SECRET=your_super_secret_key_change_this_in_production
SESSION_SECRET=your_session_secret_key

# YouTube OAuth (Google Cloud Console থেকে নিন)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/auth/youtube/callback

# Instagram OAuth (Meta Developer Dashboard থেকে নিন)
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback

# TikTok OAuth (TikTok Developer Dashboard থেকে নিন)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:5000/api/auth/tiktok/callback

UPLOAD_DIR=./uploads
DB_FILE=./db.json
